# Copy to .env and adjust.
SECRET_KEY=change-me
DATABASE_URL=postgresql://sa:Pa55w0rd@localhost:5332/myfinanceplace

# ── AI reading of scanned PDFs, photos and non-standard statements ──────────────
# Easier: configure it in the app, Impostazioni → Modelli AI (that choice wins over these values).
# Leave empty to disable. Options:
#   ollama    -> local model, nothing leaves your computer (install https://ollama.com,
#                then: ollama pull qwen2.5vl:7b)
#   anthropic -> Claude API, the document is sent to Anthropic (needs ANTHROPIC_API_KEY)
LLM_PROVIDER=
# Empty = default for the provider: qwen2.5vl:7b (ollama) / claude-opus-5 (anthropic).
# Cheaper Claude option: claude-haiku-4-5
LLM_MODEL=
OLLAMA_URL=http://localhost:11434
LLM_TIMEOUT=600
# ANTHROPIC_API_KEY=sk-ant-...
