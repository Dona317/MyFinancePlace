# Copy to .env and adjust.

# Signs the session cookie. Production refuses to start with an empty or placeholder value
# (in Docker an empty value makes the container generate one and keep it in the instance volume).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# For `python run.py` on the host. Under docker compose the app always uses the `db` service instead.
DATABASE_URL=postgresql://sa:Pa55w0rd@localhost:5332/myfinanceplace

# ── Production (wsgi.py + gunicorn, see docs/DEPLOY.md) ──────────────────────────
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# 1 when a reverse proxy (Caddy, nginx, Traefik) terminates HTTPS in front of the app:
# trusts its X-Forwarded-For/-Proto/-Host headers (PROXY_HOPS proxies in the chain).
BEHIND_PROXY=0
PROXY_HOPS=1
# Session cookies are sent over HTTPS only. Set 0 only to use the app over plain HTTP on a trusted LAN.
SESSION_COOKIE_SECURE=1
# gunicorn: keep 1 worker (model-download progress lives in memory); threads serve concurrent requests.
GUNICORN_WORKERS=1
GUNICORN_THREADS=8
# Empty = LLM_TIMEOUT + 120 s, so a long AI reading is not cut by the worker timeout.
GUNICORN_TIMEOUT=
# Host port published by docker compose.
APP_PORT=8000
# Time zone of the container (dates such as "today" and the current month).
TZ=Europe/Rome

# ── AI reading of scanned PDFs, photos and non-standard statements ──────────────
# Easier: configure it in the app, Impostazioni → Modelli AI (that choice wins over these values).
# Leave empty to disable. Options:
#   ollama    -> local model, nothing leaves your computer (install https://ollama.com,
#                then: ollama pull qwen2.5vl:7b)
#   anthropic -> Claude API, the document is sent to Anthropic (needs ANTHROPIC_API_KEY)
LLM_PROVIDER=
# Empty = default for the provider: qwen2.5vl:7b (ollama) / claude-opus-5 (anthropic).
# Cheaper Claude option: claude-haiku-4-5
LLM_MODEL=
# Under docker compose the app reaches Ollama on the host at http://host.docker.internal:11434
# (override with DOCKER_OLLAMA_URL).
OLLAMA_URL=http://localhost:11434
LLM_TIMEOUT=600
# ANTHROPIC_API_KEY=sk-ant-...
